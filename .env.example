# Copie este arquivo para .env e preencha os valores antes de rodar o projeto.
# NUNCA commite o .env com valores reais.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=financeiro

# ─── Aplicação ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://financeiro:TROQUE_POR_SENHA_FORTE@localhost:5432/financeiro?schema=public"

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="TROQUE_POR_SEGREDO_ALEATORIO_32_CHARS_MINIMO"
NEXTAUTH_URL="http://localhost:3000"

# ─── Seed (apenas para ambiente de desenvolvimento) ───────────────────────────
SEED_USER_EMAIL=usuario@example.com
SEED_USER_PASSWORD=Troque@Senha123

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Obtenha em: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="SEU_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="SEU_GOOGLE_CLIENT_SECRET"
