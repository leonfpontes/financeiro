generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  timeZone     String   @default("America/Sao_Paulo")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entradas        Entrada[]
  gastos          Gasto[]
  compromissos    Compromisso[]
  configUsuario   ConfigUsuario?
  realizadoMensal RealizadoMensal[]
  snapshotMensal  SnapshotMensal[]

  @@map("users")
}

// ─── Fotografia Financeira ────────────────────────────────────────────────────

enum EntradaTipo {
  FIXA
  VARIAVEL
}

enum GastoTipo {
  FIXO
  VARIAVEL
  SAZONAL
}

enum PeriodoInput {
  SEMANAL
  MENSAL
}

enum CompromissoTipo {
  DIVIDA
  INVESTIMENTO
  SONHO
}

enum GrupoRealizado {
  ENTRADAS
  GASTOS_FIXOS
  GASTOS_VARIAVEIS
  GASTOS_SAZONAIS
  COMPROMISSOS
}

model Entrada {
  id        String     @id @default(cuid())
  nome      String     @db.VarChar(255)
  tipo      EntradaTipo
  valor     Decimal    @db.Decimal(12, 2)
  ativo     Boolean    @default(true)
  notas     String?    @db.VarChar(500)
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("entradas")
}

model Gasto {
  id               String        @id @default(cuid())
  nome             String        @db.VarChar(255)
  tipo             GastoTipo
  valor            Decimal       @db.Decimal(12, 2)
  periodoInput     PeriodoInput?
  mesesOcorrencia  Int[]
  ativo            Boolean       @default(true)
  dataInicio       DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  dataFim          DateTime?     @db.Date
  icone            String?       @db.VarChar(50)
  notas            String?       @db.VarChar(500)
  userId           String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gastos")
}

model Compromisso {
  id           String          @id @default(cuid())
  nome         String          @db.VarChar(255)
  tipo         CompromissoTipo
  valorMensal  Decimal         @db.Decimal(12, 2)
  ativo        Boolean         @default(true)
  notas        String?         @db.VarChar(500)
  userId       String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("compromissos")
}

model ConfigUsuario {
  id             String   @id @default(cuid())
  margemPercent  Decimal  @default(15) @db.Decimal(5, 2)
  tetoCreditCard Decimal? @db.Decimal(12, 2)
  notasPlanoAcao String?  @db.VarChar(2000)
  userId         String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("config_usuario")
}

model RealizadoMensal {
  id             String         @id @default(cuid())
  mesAno         String         @db.VarChar(7)
  grupo          GrupoRealizado
  valorRealizado Decimal        @db.Decimal(12, 2)
  userId         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mesAno, grupo])
  @@index([userId, mesAno])
  @@map("realizado_mensal")
}

model SnapshotMensal {
  id              String   @id @default(cuid())
  mesAno          String   @db.VarChar(7)
  entradas        Decimal  @db.Decimal(12, 2)
  compromissos    Decimal  @db.Decimal(12, 2)
  gastosFixos     Decimal  @db.Decimal(12, 2)
  gastosVariaveis Decimal  @db.Decimal(12, 2)
  gastosSazonais  Decimal  @db.Decimal(12, 2)
  margem          Decimal  @db.Decimal(12, 2)
  margemPercent   Decimal  @db.Decimal(5, 2)
  userId          String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mesAno])
  @@index([userId])
  @@map("snapshot_mensal")
}
